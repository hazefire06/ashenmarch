[gd_resource type="Resource" script_class="CampaignDef" format=3]

[ext_resource type="Script" path="res://sim/missions/campaign_def.gd" id="1_cmp01"]
[ext_resource type="Resource" path="res://data/missions/riverside/mission.tres" id="2_mis01"]
[ext_resource type="Resource" path="res://data/missions/the_ford/mission.tres" id="3_mis02"]
[ext_resource type="Resource" path="res://data/missions/old_mill/mission.tres" id="4_mis03"]
[ext_resource type="Script" path="res://sim/missions/mission_def.gd" id="5_mdf01"]

; The Ashenmarch campaign, phase 8: three missions in play order, each darker
; than the last. Riverside is a tutorial and something wrong in the fields; The
; Ford is an escort through grey country with the dead in the water; Old Mill is
; the last stand in the ash. Adding a mission is adding a MissionDef (its map,
; its script, its roster) to the list, not engine code. A hand-written
; CampaignDef; the editor drops these comments if it re-saves it.
;
; soldier_names are the given names recruits are called by, in the order they
; are handed out: plain, human, mostly Scots, and original to this game. A
; name is picked by the soldier's id, and each further lap of the list (after
; 64 recruits) adds a roman numeral (CampaignState.name_for). The first 56
; alternate between men's and women's names (men's at the even places), so a
; company drawn from the start of the list is a mix; the last 8 are all men's,
; so a very large company late in a campaign leans that way. There must be at
; least CampaignDef.MIN_NAMES (50), all different.

[resource]
script = ExtResource("1_cmp01")
missions = Array[ExtResource("5_mdf01")]([ExtResource("2_mis01"), ExtResource("3_mis02"), ExtResource("4_mis03")])
soldier_names = PackedStringArray("Alasdair", "Ailsa", "Angus", "Agnes", "Archie", "Annis", "Alpin", "Bridie", "Boyd", "Catriona", "Calum", "Effie", "Cameron", "Eilidh", "Colin", "Elspeth", "Craig", "Fenella", "Donald", "Fiona", "Douglas", "Flora", "Dugald", "Greer", "Duncan", "Grizel", "Ewan", "Isla", "Finlay", "Ishbel", "Fraser", "Jean", "Gavin", "Kenna", "Gordon", "Kirsty", "Graham", "Lorna", "Hamish", "Mairi", "Hector", "Moira", "Iain", "Morag", "Kenneth", "Nessa", "Keir", "Peigi", "Lachlan", "Rhona", "Lorne", "Senga", "Magnus", "Shona", "Malcolm", "Una", "Murdo", "Neil", "Niall", "Ranald", "Rory", "Ross", "Ruaridh", "Struan")
