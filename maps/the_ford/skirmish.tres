[gd_resource type="Resource" script_class="SkirmishMap" format=3]

[ext_resource type="Script" path="res://sim/skirmish/skirmish_map.gd" id="1_skm01"]
[ext_resource type="Resource" path="res://maps/the_ford/the_ford.tres" id="2_map01"]
[ext_resource type="Resource" path="res://data/atmospheres/the_ford.tres" id="3_atm01"]

; The Ford as a skirmish map (SkirmishMap). Positions are milli-units (1000 =
; 1 m); z grows southward. The river runs west to east across the middle and
; the ford (x 186 to 198) is the only way across for living units; the dead
; wade anywhere. Hand-written; the editor drops these comments if it re-saves
; the file.
;
; Start A is on the south bank at (192, 330) m facing north (0, -1); start B
; on the north bank at (192, 54) m, west of the hamlet's palisade, facing south
; (0, 1). Three flags: 0 the hill, in the ford itself at (192, 192), so the
; side that holds it stands in the water; 1 on the south bank to the
; south-west (110, 250); 2 on the north bank to the north-east (274, 134), at
; the edge of the east woods. The flag radius is 6 m, not the usual 8, so the
; ford's flag reaches no deep water (it holds depth 2 at most). Each start is
; 138 m from the hill and 115 m from "its" flag.

[resource]
script = ExtResource("1_skm01")
id = &"the_ford"
display_name = "The Ford"
map = ExtResource("2_map01")
spawns = PackedInt32Array(192000, 330000, 192000, 54000)
spawn_facing = PackedInt32Array(0, -1, 0, 1)
flags = PackedInt32Array(192000, 192000, 110000, 250000, 274000, 134000)
hill = 0
flag_radius = 6000
atmosphere = ExtResource("3_atm01")
