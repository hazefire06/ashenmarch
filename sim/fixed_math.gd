class_name FixedMath
extends RefCounted
## Integer math helpers for sim code. Results are exact integers, so they are
## identical on every platform.
##
## Angles are binary angles: ANGLE_FULL units per turn, so wrapping is a bit
## mask. Sines and cosines are fixed-point with TRIG_ONE as 1.0. Unit direction
## vectors (facings) have length DIR_ONE.

const ANGLE_FULL: int = 1024
const ANGLE_QUARTER: int = ANGLE_FULL / 4
const ANGLE_HALF: int = ANGLE_FULL / 2
const TRIG_ONE: int = 65536
const DIR_ONE: int = 1000
## 2 * pi * 1000, rounded: circumference = radius * TWO_PI_MILLI / 1000.
const TWO_PI_MILLI: int = 6283
## normalize() scales inputs up to at least this before taking the length.
const NORMALIZE_MIN_MAGNITUDE: int = 1 << 20

## sin(k * 2pi / ANGLE_FULL) * TRIG_ONE for k in 0..ANGLE_QUARTER, rounded.
## Generated by scripts/gen_sine_table.py so the sim never calls sin(): libm
## differs in the last bit between platforms.
const SIN_QUARTER: Array[int] = [
	0, 402, 804, 1206, 1608, 2010, 2412, 2814, 3216, 3617, 4019, 4420,
	4821, 5222, 5623, 6023, 6424, 6824, 7224, 7623, 8022, 8421, 8820, 9218,
