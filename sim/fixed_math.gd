## Floor of the square root of n, for 0 <= n < 2^62. Negative input returns 0.
static func isqrt(n: int) -> int:
	if n <= 0:
		return 0
	# The float root is only a starting guess. The loops correct it to the
	# exact floor, so the result never depends on float rounding.
	var r: int = int(sqrt(float(n)))  # purity-ok: a guess, corrected exactly below
	while r * r > n:
		r -= 1
	while (r + 1) * (r + 1) <= n:
		r += 1
	return r


## a / b rounded toward negative infinity, for b > 0. GDScript's / truncates
## toward zero, which rounds negative values the wrong way.
static func div_floor(a: int, b: int) -> int:
	var q: int = a / b
	if a % b != 0 and a < 0:
		q -= 1
	return q


## a / b rounded to the nearest integer, halves away from zero, for b > 0.
## Symmetric: div_round(-a, b) == -div_round(a, b).
static func div_round(a: int, b: int) -> int:
	if a < 0:
		return -((-a + b / 2) / b)
	return (a + b / 2) / b


## sin of a binary angle, times TRIG_ONE. Any angle wraps, negatives included.
static func sin_b(angle: int) -> int:
	var a: int = angle & (ANGLE_FULL - 1)
	if a < ANGLE_QUARTER:
		return SIN_QUARTER[a]
	if a < ANGLE_HALF:
		return SIN_QUARTER[ANGLE_HALF - a]
	if a < ANGLE_HALF + ANGLE_QUARTER:
		return -SIN_QUARTER[a - ANGLE_HALF]
	return -SIN_QUARTER[ANGLE_FULL - a]


## cos of a binary angle, times TRIG_ONE.
static func cos_b(angle: int) -> int:
	return sin_b(angle + ANGLE_QUARTER)


## Euclidean length of (x, z), floored.
static func length(x: int, z: int) -> int:
	return isqrt(x * x + z * z)


## (x, z) scaled to the given length, each component rounded. The zero vector
## stays zero. Components must be below 2^30 in magnitude.
static func normalize(x: int, z: int, new_length: int) -> Vector2i:
	if x == 0 and z == 0:
		return Vector2i.ZERO
	# isqrt floors, which is a large relative error for short vectors (|(3, 7)|
	# would be 7, not 7.6). Scale the larger component up to at least 2^20
	# first; direction is unchanged and the floor error becomes negligible.
	var sx: int = x
	var sz: int = z
	var big: int = maxi(absi(x), absi(z))
	while big < NORMALIZE_MIN_MAGNITUDE:
		sx *= 2
		sz *= 2
		big *= 2
	var magnitude: int = length(sx, sz)
	return Vector2i(div_round(sx * new_length, magnitude), div_round(sz * new_length, magnitude))


## World (x, z) offset of a local (right, forward) offset for a unit facing
## (facing_x, facing_z), a direction of length DIR_ONE. Right is
## (-facing_z, facing_x): facing -z (north), right is +x (east).
static func rotate_local(right: int, forward: int, facing_x: int, facing_z: int) -> Vector2i:
	return Vector2i(
		div_round(-right * facing_z + forward * facing_x, DIR_ONE),
		div_round(right * facing_x + forward * facing_z, DIR_ONE)
	)
