[gd_resource type="Resource" script_class="Atmosphere" format=3]

[ext_resource type="Script" path="res://view/atmosphere/atmosphere.gd" id="1_atm01"]

; The Ford: overcast, the grey spreading. About 40% of the way to the
; campaign's end: a flat grey-green sky and a dull diffuse light, a mist along
; the valley, the colour drawn out of the ground (desaturated by 0.35) and the
; grass gone to straw, and the river thick and murky. No ash yet. Colors are
; linear 0..1.
[resource]
script = ExtResource("1_atm01")
; The sky: flat, overcast, a green in the grey.
background_color = Color(0.46, 0.5, 0.46, 1)
; Light with no direction to it: a cool dim ambient and a weak, high sun.
ambient_color = Color(0.62, 0.66, 0.62, 1)
ambient_energy = 0.55
sun_color = Color(0.82, 0.86, 0.8, 1)
sun_energy = 0.6
sun_pitch_degrees = -50.0
; Light fog, a little thicker than a haze (0.01), grey-green.
fog_enabled = true
fog_color = Color(0.55, 0.6, 0.55, 1)
fog_density = 0.008
; The ground: a greenish cast, then 0.35 of the colour drained out.
terrain_tint = Color(0.92, 0.95, 0.88, 1)
terrain_desaturation = 0.35
; Dead grass: one color per Terrain.Ground in order (0 GRASS, 1 BRUSH, 2 WOOD,
; 3 SAND, 4 ROCK), its alpha how much it takes over. Grass goes to straw, brush
; to dry brown, wood to dark and dull, sand and rock barely touched.
ground_recolor = Array[Color]([Color(0.62, 0.58, 0.32, 0.45), Color(0.45, 0.38, 0.22, 0.35), Color(0.3, 0.28, 0.2, 0.25), Color(0.6, 0.57, 0.45, 0.15), Color(0.45, 0.45, 0.43, 0.1)])
; Murky water: a brown-green blended over it by more than half.
water_tint = Color(0.18, 0.24, 0.14, 0.55)
