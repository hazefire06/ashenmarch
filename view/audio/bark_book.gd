class_name BarkBook
extends Resource
## Every bark line by unit and trigger. Generated by `make audio-build` from
## audio-src/voices/*.toml; never edit data/audio/barks.tres by hand. View only.

const PATH: String = "res://data/audio/barks.tres"

@export var lines: Array[BarkLine] = []
## Bytes of every voiced stream's imported file, for the audio budget.
@export var voiced_bytes: int = 0

## The session's book, loaded once and never freed (an empty one if PATH is missing).
static var _shared: BarkBook = null


static func shared() -> BarkBook:
	if _shared == null:
		if ResourceLoader.exists(PATH):
			_shared = load(PATH) as BarkBook
		if _shared == null:
			push_warning("BarkBook: %s is missing; there will be no barks" % PATH)
			_shared = BarkBook.new()
	return _shared


## The unit's own lines for a trigger (clan lines are not included).
func lines_for(unit: StringName, trigger: StringName) -> Array[BarkLine]:
	var found: Array[BarkLine] = []
	for line: BarkLine in lines:
		if not line.clan and line.unit == unit and line.trigger == trigger:
			found.append(line)
	return found


func clan_lines() -> Array[BarkLine]:
	var found: Array[BarkLine] = []
	for line: BarkLine in lines:
		if line.clan:
			found.append(line)
	return found


func has_trigger(unit: StringName, trigger: StringName) -> bool:
	return not lines_for(unit, trigger).is_empty()


## Every voiced stream's imported bytes, written by the builder.
func file_bytes() -> int:
	return voiced_bytes
