#!/bin/sh
# Leak scan before every commit. `make hooks` copies this into the repo's
# shared hooks folder, so it runs in every worktree; a checkout without
# .gitleaks.toml (one that predates the art track) skips it.
[ -f .gitleaks.toml ] || exit 0
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed (brew install gitleaks)" >&2
	exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
