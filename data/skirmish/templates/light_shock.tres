[gd_resource type="Resource" script_class="ArmyTemplate" format=3]

[ext_resource type="Script" path="res://sim/skirmish/army_template.gd" id="1_atp01"]

; An AI skirmish army (ArmyTemplate): Reavers to break a line, a few shields and bows to cover them.
; Each entry spends its share of the budget (permille, together 1000) on its
; type; ArmyTemplate.fill rounds down, then spends what is left on whichever
; entry is furthest below its share. Hand-written; the editor drops these
; comments if it re-saves the file.
; faction: 0 LIGHT, 1 DARK

[resource]
script = ExtResource("1_atp01")
id = &"light_shock"
display_name = "Shock"
faction = 0
type_ids = Array[StringName]([&"shieldman", &"reaver", &"longbow", &"warden"])
shares_permille = PackedInt32Array(200, 500, 150, 150)
